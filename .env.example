# Docker Compose workflows:
# - Dev stack (hot-reload + dedicated migrate container): docker compose -f docker-compose.dev.yml up --build
# - Prod stack (hardened non-root backend + Nginx):       docker compose -f docker-compose.prod.yml up -d --build

# Application environment: "dev" (console logs) or "prod" (PostgreSQL + JSON logs)
APP_ENV=dev

# Required: >= 32 characters (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# Local host database URL (Compose stacks automatically target the db service):
# - dev host:  sqlite+aiosqlite:///./data/presentation_timer.db
# - prod host: postgresql+asyncpg://app:app_secret@db:5432/presentation_timer
DATABASE_URL=sqlite+aiosqlite:///./data/presentation_timer.db

# Optional overrides
# LOG_LEVEL=DEBUG
# UVICORN_WORKERS=2
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL credentials (used by docker-compose.dev.yml and docker-compose.prod.yml)
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=presentation_timer
