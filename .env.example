# Application environment: "dev" (SQLite + console logs) or "prod" (PostgreSQL + JSON logs)
APP_ENV=dev

# Required: >= 32 characters (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# Database URL:
# - dev:  sqlite+aiosqlite:///./data/presentation_timer.db
# - prod: postgresql+asyncpg://app:app_secret@postgres:5432/presentation_timer
DATABASE_URL=sqlite+aiosqlite:///./data/presentation_timer.db

# Optional overrides
# LOG_LEVEL=DEBUG
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL (used when running: docker compose --profile prod up --build)
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=presentation_timer
